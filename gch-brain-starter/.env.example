# Copy this file to ".env" and fill in your real values.
# Never commit the real .env to git.

APIFY_TOKEN=your_apify_token_here
OPENAI_API_KEY=your_openai_key_here

# From Supabase: Project URL and the SECRET service_role key
SUPABASE_URL=https://agwmhjzkfnzisxxjmcuc.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_secret_key_here

# Stripe: use a RESTRICTED, read-only key (Developers > API keys > Create restricted key)
STRIPE_API_KEY=rk_live_your_restricted_read_only_key_here

# KPI sheet stays PRIVATE: download it as CSV (File > Download > CSV), save as
# kpi.csv next to the scripts. No publishing. (Override path with KPI_CSV if needed.)
# KPI_CSV=/full/path/to/kpi.csv
